<?xml version="1.0" encoding="UTF-8"?>
<!--
    JaCoCo 覆盖率规则配置文件
    用于 check-coverage.sh 脚本

    单位说明:
    - INSTRUCTION: 字节码指令覆盖率
    - BRANCH: 分支覆盖率 (if/switch 等)
    - LINE: 代码行覆盖率
    - CLASS: 类覆盖率
    - METHOD: 方法覆盖率

    minimum 值说明 (小数形式):
    - 0.5 = 50%
    - 0.8 = 80%
    - 1.0 = 100%
-->
<ruleset>
    <rule>
        <!-- 指令覆盖率: 至少 50% -->
        <name>Instruction Coverage</name>
        <counter>INSTRUCTION</counter>
        <minimum>0.50</minimum>
    </rule>

    <rule>
        <!-- 分支覆盖率: 至少 50% -->
        <name>Branch Coverage</name>
        <counter>BRANCH</counter>
        <minimum>0.50</minimum>
    </rule>

    <rule>
        <!-- 行覆盖率: 至少 50% -->
        <name>Line Coverage</name>
        <counter>LINE</counter>
        <minimum>0.50</minimum>
    </rule>

    <rule>
        <!-- 类覆盖率: 至少 50% -->
        <name>Class Coverage</name>
        <counter>CLASS</counter>
        <minimum>0.50</minimum>
    </rule>
</ruleset>
