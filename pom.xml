            <dependency>
                <groupId>org.apache.bifromq.testsuite</groupId>
                <artifactId>test-suite-framework</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.bifromq.testsuite</groupId>
